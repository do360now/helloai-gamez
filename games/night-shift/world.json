  "rooms": {
    "floor": {
      "name": "Arcade floor",
      "text": "Two in the morning at the Starlight Arcade. The cabinets are still on, each one running its attract screen for nobody, and their glow puts long colored shadows across the carpet you were hired to vacuum. A Block Drop cabinet stands by the front window. Beside it is a square of carpet that is cleaner than the rest, where a cabinet used to be. Your mop and bucket wait by the door to the prize counter.",
      "extra": [
        { "require": { "flags": { "officeOpen": true } }, "text": "The office door stands open." },
        { "require": { "flags": { "serviceSeen": true } }, "text": "The Block Drop cabinet is sulking in service mode." }
      ],
      "exits": [
        { "dir": "north", "to": "office", "name": "the office door", "require": { "flags": { "officeOpen": true } }, "fail": "The office door is locked." },
        { "dir": "east", "to": "counter", "name": "the prize counter" }
