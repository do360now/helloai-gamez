    },
    {
      "id": "open-grille",
      "when": { "verb": "open", "object": "grille" },
      "do": [{ "reply": "The padlock at the floor disagrees." }]
    },
    {
      "id": "open-register",
      "when": { "verb": "open", "object": "register" },
      "do": [{ "reply": "You were told never to touch it. You don't." }]
    },
    {
