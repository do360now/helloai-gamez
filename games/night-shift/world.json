      "hotspot": [274, 152, 22, 18]
    },
    "cord": {
      "name": "frayed power cord",
      "nouns": ["frayed power cord", "cord", "power cord", "frayed cord", "wire", "cable"],
      "text": "The power cord that fed the missing cabinet. It trails from the wall into the clean square of carpet, and the insulation near the plug is split open to the copper.",
