  "objects": {
    "cabinet": {
      "name": "Block Drop cabinet",
      "nouns": ["block drop cabinet", "cabinet", "block drop", "machine", "game"],
      "text": "A Block Drop cabinet, the arcade's pride, with a coin slot, a joystick worn smooth, and the high score board glowing above the screen. The attract screen drops blocks for no one.",
      "hotspot": [40, 50, 56, 110]
    },
    "board": {
      "name": "high score board",
      "nouns": ["high score board", "board", "scores", "high scores", "score board"],
      "text": "The high score board lists ten names. The top one is new: ZZZ, 999,999 points, entered at 3:07 this morning. Nobody was playing at 3:07; you locked the doors at midnight. Below it, the honest scores, the best of them by someone who signs as PRI.",
      "hotspot": [36, 26, 64, 18]
    },
    "gap": {
      "name": "clean square of carpet",
      "nouns": ["clean square of carpet", "square", "carpet", "clean square", "space", "gap"],
      "text": "A rectangle of carpet, cleaner and darker than the rest, with four dents where the feet of a cabinet stood for years. A power cord trails from the wall into the space and ends in nothing.",
      "hotspot": [100, 150, 40, 32]
    },
    "mop": {
      "name": "mop",
      "nouns": ["mop"],
      "text": "A string mop, mostly gray. It came with the job.",
