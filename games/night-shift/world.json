      "nouns": ["framed photo", "photo", "photograph", "picture", "frame"],
      "text": "Opening day, 1979: a younger Marge and a man in a wide tie cut a ribbon in front of the arcade. The frame is light, and something is written on the back of the print.",
      "hotspot": [30, 50, 26, 34]
    },
    "panel": {
      "name": "switch panel",
      "nouns": ["switch panel", "panel", "switches", "key switch", "key switches", "switch"],
      "text": "A panel of keyed switches, one per cabinet, each labeled with a game. Turned to EDIT, a switch lets whoever holds the key rewrite that cabinet's high score board. The Block Drop switch is turned to EDIT right now.",
      "hotspot": [250, 40, 50, 60]
    },
    "marge": {
      "name": "Marge",
      "nouns": ["marge", "owner", "woman", "boss"],
      "text": "Marge Okafor, sixty, owner of the Starlight since opening day. Reading glasses, a cardigan, and a pencil she never puts down.",
      "person": true,
      "hotspot": [186, 52, 30, 56],
      "topics": {
        "cabinet": {
          "synonyms": ["missing cabinet", "gap", "carpet", "clean square", "space"],
          "reply": "\"The Galaxy Patrol cabinet. Gone when I came down at one. ${witness} was in and out of here all evening, if you want somewhere to start.\""
        },
        "board": {
          "synonyms": ["high score board", "scores", "high scores", "score board", "zzz"],
          "reply": "\"Nobody scores 999,999. Only the office panel can edit a board, and the panel key never leaves my ring.\" She touches the ring on her belt and frowns."
        },
        "panel": {
          "synonyms": ["switches", "switch", "key switch", "edit"],
          "reply": "\"Turned to EDIT? I never leave it on EDIT.\" She looks at the panel for a long moment and says nothing else."
        },
        "safe": {
          "synonyms": ["combination", "dial"],
          "reply": "\"The safe is my business. You are the janitor.\""
        },
        "photo": {
          "synonyms": ["picture", "photograph"],
          "reply": "\"Opening day. That's Walt, my first partner. He's gone now, and so is his head for numbers.\""
        },
        "night": {
          "synonyms": ["job", "work", "shift", "arcade", "starlight"],
          "reply": "\"Vacuum, mop, lock up. And now, apparently, find my cabinet.\""
        }
      }
    }
  },
  "rules": [
    {
      "id": "notice-board",
      "when": { "verb": "look", "object": "board" },
      "do": [{ "score": 5 }, { "flag": "sawBoard", "value": true }]
    },
    {
      "id": "find-token",
      "when": { "verb": "search", "object": "cabinet" },
      "require": { "flags": { "foundToken": false } },
      "do": [
        { "reveal": "token" },
        { "flag": "foundToken", "value": true },
        { "score": 5 },
        { "reply": "You get down on the carpet and look under the cabinet. Dust, a bottle cap, and a brass arcade token, which rolls out when you poke it with the mop handle." }
      ]
    },
    {
      "id": "find-token-again",
      "when": { "verb": "search", "object": "cabinet" },
      "require": { "flags": { "foundToken": true } },
      "do": [{ "reply": "Dust and a bottle cap. Nothing else under there." }]
    },
    {
      "id": "service-mode",
      "when": { "verb": "put", "object": "token", "target": "cabinet" },
      "require": { "has": ["token"], "flags": { "serviceSeen": false } },
      "do": [
        { "move": "token", "to": null },
        { "flag": "serviceSeen", "value": true },
        { "score": 10 },
        { "reply": "The token drops. Instead of a game, the screen flips to a service page nobody was meant to see: LAST BOARD EDIT 03:07 FROM OFFICE PANEL. The cabinet keeps the token." }
      ]
    },
    {
      "id": "service-mode-use",
      "when": { "verb": "use", "object": "token", "target": "cabinet" },
      "require": { "has": ["token"], "flags": { "serviceSeen": false } },
      "do": [
        { "move": "token", "to": null },
        { "flag": "serviceSeen", "value": true },
        { "score": 10, "id": "service-mode" },
        { "reply": "The token drops. Instead of a game, the screen flips to a service page nobody was meant to see: LAST BOARD EDIT 03:07 FROM OFFICE PANEL. The cabinet keeps the token." }
      ]
    },
    {
      "id": "play-cabinet",
      "when": { "verb": "play", "object": "cabinet" },
      "do": [{ "reply": "The coin slot wants a token, and the attract screen wants an audience. You have neither." }]
    },
    {
      "id": "play-cabinet-service",
      "when": { "verb": "play", "object": "cabinet" },
      "require": { "flags": { "serviceSeen": true } },
      "do": [{ "reply": "The cabinet is stuck on its service page: LAST BOARD EDIT 03:07 FROM OFFICE PANEL." }]
    },
    {
      "id": "pull-cord",
      "when": { "verb": "pull", "object": "cord" },
      "do": [{ "die": "You take hold of the frayed cord and pull. The split insulation finds your palm, the wall outlet finds the rest of you, and for one bright instant you are the best-lit thing in the Starlight. The attract screens never notice." }]
    },
    {
      "id": "take-cord",
      "when": { "verb": "take", "object": "cord" },
      "do": [{ "die": "You grab the cord by the bare part. It is still plugged in. Your last thought is that someone should really have unplugged that." }]
    },
    {
      "id": "unplug-cord",
      "when": { "verb": "use", "object": "mop", "target": "cord" },
      "do": [{ "reply": "You nudge the cord aside with the mop handle. It sparks against the baseboard. Good instinct not to use your hand." }]
    },
    {
      "id": "clean-floor",
      "when": { "verb": "clean", "object": "gap" },
      "do": [{ "reply": "It is already the cleanest carpet in the building. That is rather the point." }]
    },
    {
      "id": "read-ledger",
      "when": { "verb": "read", "object": "ledger" },
      "do": [
        { "score": 5 },
        { "flag": "readLedger", "value": true },
        { "reply": "The last line, in a hurried hand: 2:50 AM, PICKUP, 1 CABINET (GALAXY PATROL), and a signature that is mostly a loop. Two-fifty. Seventeen minutes before somebody typed ZZZ into the high score board." }
      ]
    },
    {
      "id": "read-ledger-look",
      "when": { "verb": "look", "object": "ledger" },
      "do": [
        { "score": 5, "id": "read-ledger" },
        { "flag": "readLedger", "value": true },
        { "reply": "The last line, in a hurried hand: 2:50 AM, PICKUP, 1 CABINET (GALAXY PATROL), and a signature that is mostly a loop. Two-fifty. Seventeen minutes before somebody typed ZZZ into the high score board." }
      ]
    },
    {
      "id": "drink-slush",
      "when": { "verb": "drink", "object": "slush" },
      "do": [{ "die": "You pull the lever and drink straight from the spout. The Blue Raspberry has been fermenting since Labor Day, and it has opinions. You sit down on the floor to think about them and do not get up." }]
    },
    {
      "id": "open-locker1",
