      "do": [{ "reveal": "officekey" }, { "flag": "foundKey", "value": true }, { "reply": "The locker opens with a squeal. A raincoat, a lunch box, and on a hook inside the door, a brass key." }]
    },
    {
      "id": "open-locker2",
      "when": { "verb": "open", "object": "locker2" },
