      "when": { "verb": "turn", "object": "photo" },
      "do": [{ "flag": "readPhoto", "value": true }, { "reply": "You turn the frame over. On the back of the print, in pencil, in a hand that is not Marge's: ${combo}. Under it, smaller: DON'T FORGET AGAIN, WALT." }]
