{
  "name": "helloai-gamez-tools",
  "private": true,
  "type": "module",
  "description": "Run baseline agents, verify recorded runs, and rebuild data/runs/index.json.",
  "scripts": {
    "serve": "python3 -m http.server 8765 --directory ..",
    "agent": "node agents/run.mjs",
    "verify": "node verify.mjs",
    "smoke": "node smoke.mjs",
    "index": "node build-index.mjs",
    "test": "node --test test/*.test.mjs",
    "night-shift": "node night-shift.mjs"
  },
  "devDependencies": {
    "playwright": "1.48.0"
  }
}
